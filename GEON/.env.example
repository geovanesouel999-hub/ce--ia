# Segredos ficam somente no ambiente do servidor. Nunca envie um .env real ao GitHub.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Gere um valor aleatório com pelo menos 32 caracteres antes de produção.
SESSION_SECRET=

# PostgreSQL recomendado para memória persistente.
DATABASE_URL=
DATABASE_SSL=false

# Tavily habilita o modo Pesquisa. Sem esta chave, a pesquisa fica desativada.
TAVILY_API_KEY=

PORT=3000
TRUST_PROXY=0
